<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_mcp" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.mcp</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Merkago MCP" string="Merkago MCP" name="merkago_mcp_server"
                     groups="merkago_mcp_server.group_mcp_manager">
                    <block title="Connecteur Claude">
                        <setting string="Activer le serveur MCP" help="Expose /mcp/health et /mcp/sse pour Claude Desktop">
                            <field name="mcp_enabled"/>
                        </setting>
                        <setting string="Mode lecture seule (Safe Mode)" help="Bloque toute écriture même si les scopes l'autorisent">
                            <field name="mcp_safe_mode"/>
                        </setting>
                        <setting string="Autoriser les écritures">
                            <field name="mcp_allow_write"/>
                        </setting>
                        <setting string="Autoriser les suppressions">
                            <field name="mcp_allow_unlink"/>
                        </setting>
                        <setting string="URL publique Odoo" help="https://votre-domaine-odoo">
                            <field name="mcp_public_base_url" placeholder="https://erp.example.com"/>
                        </setting>
                        <setting string="Limites">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="mcp_default_limit" class="col-lg-3"/>
                                    <field name="mcp_default_limit"/>
                                </div>
                                <div class="row">
                                    <label for="mcp_max_limit" class="col-lg-3"/>
                                    <field name="mcp_max_limit"/>
                                </div>
                                <div class="row">
                                    <label for="mcp_daily_quota" class="col-lg-3"/>
                                    <field name="mcp_daily_quota"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Journal d'audit">
                            <field name="mcp_audit_enabled"/>
                        </setting>
                        <setting string="Outils exposés à Claude" help="Décochez un outil pour qu'il n'apparaisse plus dans Claude. Créer et Modifier restent masqués en Safe Mode.">
                            <div class="content-group">
                                <field name="mcp_tool_list"/>
                                <field name="mcp_tool_describe"/>
                                <field name="mcp_tool_search"/>
                                <field name="mcp_tool_read"/>
                                <field name="mcp_tool_create"/>
                                <field name="mcp_tool_write"/>
                                <field name="mcp_tool_company"/>
                            </div>
                        </setting>
                        <setting string="Aide connexion Claude">
                            <field name="mcp_claude_instructions" widget="text" readonly="1"/>
                            <button name="action_mcp_copy_claude_help" type="object"
                                    string="Afficher les instructions" class="btn-primary mt8"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
