<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_merkago_mcp" model="ir.module.category">
        <field name="name">Merkago MCP</field>
        <field name="description">Claude Connector Odoo (MCP)</field>
        <field name="sequence">40</field>
    </record>

    <record id="res_groups_privilege_merkago_mcp" model="res.groups.privilege">
        <field name="name">Merkago MCP</field>
        <field name="category_id" ref="module_category_merkago_mcp"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_mcp_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_merkago_mcp"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Use Merkago MCP tokens and scopes (read).</field>
    </record>

    <record id="group_mcp_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_merkago_mcp"/>
        <field name="implied_ids" eval="[(4, ref('group_mcp_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Configure MCP server, scopes, tokens and OAuth.</field>
    </record>
</odoo>
