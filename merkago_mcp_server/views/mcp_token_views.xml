<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mcp_token_tree" model="ir.ui.view">
        <field name="name">merkago.mcp.token.tree</field>
        <field name="model">merkago.mcp.token</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="token_prefix"/>
                <field name="safe_mode"/>
                <field name="call_count"/>
                <field name="last_used"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_mcp_token_form" model="ir.ui.view">
        <field name="name">merkago.mcp.token.form</field>
        <field name="model">merkago.mcp.token</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="user_id"/>
                            <field name="token_prefix" readonly="1"/>
                            <field name="safe_mode"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="daily_quota"/>
                            <field name="calls_today" readonly="1"/>
                            <field name="call_count" readonly="1"/>
                            <field name="last_used" readonly="1"/>
                            <field name="expires_at"/>
                        </group>
                    </group>
                    <group>
                        <field name="scope_ids" widget="many2many_tags"/>
                        <field name="company_ids" widget="many2many_tags"/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Create secrets via menu Merkago MCP → Generate Token.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mcp_token_wizard" model="ir.actions.act_window">
        <field name="name">Generate MCP Token</field>
        <field name="res_model">merkago.mcp.token.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_mcp_token" model="ir.actions.act_window">
        <field name="name">Tokens</field>
        <field name="res_model">merkago.mcp.token</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
