<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mcp_connect_wizard_form" model="ir.ui.view">
        <field name="name">merkago.mcp.connect.wizard.form</field>
        <field name="model">merkago.mcp.connect.wizard</field>
        <field name="arch" type="xml">
            <form string="Connecter Claude" create="0" delete="0">
                <header>
                    <button name="action_open_demo_video" type="object"
                            string="Voir la vidéo démo"
                            class="btn-danger"
                            icon="fa-youtube-play"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Connecter Claude à Odoo</h1>
                        <p class="text-muted">
                            En 2 minutes : copiez l'URL, ajoutez le connecteur dans Claude, autorisez votre compte Odoo.
                        </p>
                        <div style="margin-top:12px;">
                            <a href="https://www.youtube.com/watch?v=1nYfrDcir1c" target="_blank"
                               style="display:inline-block;background-color:#E10600;color:#ffffff;padding:12px 22px;font-size:16px;font-weight:800;text-decoration:none;">
                                Voir la vidéo démo
                            </a>
                        </div>
                    </div>

                    <div class="alert alert-success" role="alert" invisible="status != 'ok'">
                        <field name="status_message" readonly="1" nolabel="1" class="oe_inline"/>
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="status != 'warning'">
                        <field name="status_message" readonly="1" nolabel="1" class="oe_inline"/>
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="status != 'error'">
                        <field name="status_message" readonly="1" nolabel="1" class="oe_inline"/>
                    </div>
                    <field name="status" invisible="1"/>
                    <field name="oauth_sessions" invisible="1"/>

                    <group string="1. Vérifiez votre Odoo">
                        <field name="public_base_url" placeholder="https://erp.votre-domaine.com"/>
                        <field name="mcp_enabled"/>
                        <field name="mcp_safe_mode"/>
                        <field name="checklist" readonly="1" nolabel="1" colspan="2"/>
                    </group>

                    <group string="Droits en un clic">
                        <div colspan="2">
                            <button name="action_pack_contacts" type="object" string="Contacts" class="btn-secondary me-2"/>
                            <button name="action_pack_sales" type="object" string="Ventes / CRM" class="btn-secondary me-2"/>
                            <button name="action_pack_inventory" type="object" string="Stock" class="btn-secondary me-2"/>
                            <button name="action_pack_accounting" type="object" string="Comptabilité" class="btn-secondary"/>
                        </div>
                    </group>

                    <group string="Outils Claude">
                        <field name="tool_list"/>
                        <field name="tool_describe"/>
                        <field name="tool_search"/>
                        <field name="tool_read"/>
                        <field name="tool_create"/>
                        <field name="tool_write"/>
                        <field name="tool_company"/>
                    </group>

                    <group string="2. URL à coller dans Claude">
                        <field name="sse_url" readonly="1" widget="CopyClipboardChar"/>
                        <field name="health_url" readonly="1"/>
                    </group>

                    <group string="3. Étapes dans Claude Desktop">
                        <field name="instructions" readonly="1" nolabel="1" colspan="2"/>
                    </group>

                    <group string="Résultat du test" invisible="not test_result">
                        <field name="test_result" nolabel="1" colspan="2"/>
                    </group>

                    <footer>
                        <button name="action_save" type="object" string="Enregistrer"
                                class="btn-secondary"/>
                        <button name="action_show_sse_url" type="object" string="Afficher l'URL"
                                class="btn-primary"/>
                        <button name="action_test_connection" type="object" string="Tester la connexion"
                                class="btn-primary"/>
                        <button name="action_show_instructions" type="object" string="Voir les étapes"
                                class="btn-secondary"/>
                        <button name="action_open_token_wizard" type="object"
                                string="Token Bearer (avancé)" class="btn-link"/>
                        <button name="action_open_settings" type="object"
                                string="Paramètres avancés" class="btn-link"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mcp_connect_wizard" model="ir.actions.act_window">
        <field name="name">Connecter Claude</field>
        <field name="res_model">merkago.mcp.connect.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>
</odoo>
